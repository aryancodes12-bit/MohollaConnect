# Root gitignore for MohollaConnect

# Zip archives
*.zip

# Temp extraction folders
temp_zip_extract/

# Node
node_modules/
npm-debug.log*

# Build output
dist/
build/

# Gradle
.gradle/
backend/build/
backend/bin/

# Environment files (keep .env.example, ignore .env)
frontend/.env
*.env
gemini_api_key.txt
*secret*
application-local.properties

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
env/
venv/

# Metabase Standalone Binaries & Embedded DB
metabase.jar
metabase.db.*
plugins/

# IDE
.idea/
*.iml
.vscode/
*.class

# OS
.DS_Store
Thumbs.db

